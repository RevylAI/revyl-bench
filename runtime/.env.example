# Copy to .env (gitignored). launch_rollout.py reads this file on the launch machine and
# writes the SUBSET each container may see into runner.env / agent.env.
REVYL_GRADING_API_KEY=      # Grading Revyl Bench org f769c864-…  → runner container only
REVYL_AGENT_API_KEY=        # Agent Revyl Bench org 3fa36cab-…    → agent container only
EXPO_TOKEN=                 # OPTIONAL since 2026-08-26: only `launch_rollout.py --builder eas` (rollback) and provision/make_devclient.py use it → runner container only (agent never builds)
ANTHROPIC_API_KEY=          # contestant claude-code/*   → agent container only
OPENAI_API_KEY=             # contestant codex/*
MOONSHOT_API_KEY=           # contestant opencode/kimi-*

# The two Revyl organisations this deployment runs against (docs/organizations.md).
# Ids are not secret; they pair with the keys above and every launch guard checks that
# each key really resolves to the org named here.
REVYL_GRADING_ORG_ID=      # holds the hidden suites and the per-task grading app; grades every submission
REVYL_AGENT_ORG_ID=        # the dev loop: dev-client builds and the device sessions the agent drives

# ---- contestant credentials -------------------------------------------------------------
# One per harness/provider. You only need the one named by `key_env` of the contestant you
# launch (contestants/registry.yaml); launch_rollout.py refuses to start if it is empty, and
# it is the only model credential copied into that rollout's agent container.
CLAUDE_CODE_OAUTH_TOKEN=   # claude-code/* rows, ALTERNATIVE to ANTHROPIC_API_KEY (set the row's key_env to this): output of `claude setup-token`
CODEX_AUTH_B64=            # codex/* rows: base64 of ~/.codex/auth.json after `codex login` (ChatGPT-plan login, no API key)
OPENCODE_API_KEY=          # opencode/glm-5.2, opencode/muse-spark-1.3: the opencode gateway key
DEEPINFRA_API_KEY=         # opencode/nemotron3-ultra-deepinfra
VLLM_API_KEY=              # opencode/nemotron3-nano: bearer token of YOUR OpenAI-compatible vLLM server
VLLM_BASE_URL=             # optional: overrides that row's base_url (https://<host>/v1); not a secret
